  "mass_bins": 50,
  "systematic_variations": ["signal_model", "background_model", "mass_window", "alternate_binning", "pileup", "official_loose_id"],
  "adoption_gates": [
    "trigger-object matching and unbiased-probe audit",
    "simultaneous pass/fail fit convergence in every adopted bin",
    "data and MC goodness-of-fit",
    "official LooseID multiplication and uncertainty propagation test",
    "bin-by-bin scale-factor stability under fit-model, fit-window, binning, and pileup variations"
  ]
