  take SRpresel
  select size(bJets) == 1
  select Nbst == 0
  select Nmix == 1
  select Nres == 0
  select Nw == 0
  bin pT(PuppiMET[0]) >= 250 and pT(PuppiMET[0]) < 300
  bin pT(PuppiMET[0]) >= 300 and pT(PuppiMET[0]) < 350
  bin pT(PuppiMET[0]) >= 350 and pT(PuppiMET[0]) < 400
  bin pT(PuppiMET[0]) >= 400 and pT(PuppiMET[0]) < 500
