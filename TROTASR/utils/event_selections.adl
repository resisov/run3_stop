region CRlostLeptonlowdM
  take collisionDataQuality
  trigger HLTMETMHT
  select size(vetoLeptons) == 1
  select size(selectedHadTaus) == 0
  select size(isotracks) == 0
  select size(ak4Jets) >= 2
  select size(bJets) >= 1
  select HT > 300
  select pT(PuppiMET[0]) > 250
  select fMT(vetoLeptons[0], PuppiMET[0]) < 100
  select Nbst == 0
  select Nmix == 0
  select Nw == 0
  select Nres == 0
  select dphi(ak4Jets[0], PuppiMET[0]) > 0.5
  select dphi(ak4Jets[1], PuppiMET[0]) > 0.15
  select size(ak4Jets) < 3 or dphi(ak4Jets[2], PuppiMET[0]) > 0.15

region CRmultijetlowdM
  take collisionDataQuality
  trigger HLTMETMHT
  select size(vetoLeptons) == 0
  select size(selectedHadTaus) == 0
  select size(isotracks) == 0
  select size(ak4Jets) >= 2
  select size(bJets) >= 1
  select HT > 300
  select pT(PuppiMET[0]) > 250
  select Nbst == 0
  select Nmix == 0
  select Nw == 0
  select Nres == 0
  select dphi(ak4Jets[0], PuppiMET[0]) < 0.5 or
         dphi(ak4Jets[1], PuppiMET[0]) < 0.5 or
         (size(ak4Jets) >= 3 and dphi(ak4Jets[2], PuppiMET[0]) < 0.5) or
         (size(ak4Jets) >= 4 and dphi(ak4Jets[3], PuppiMET[0]) < 0.5)
  select dphi(ak4Jets[0], PuppiMET[0]) < 0.1 or
         dphi(ak4Jets[1], PuppiMET[0]) < 0.1 or
         (size(ak4Jets) >= 3 and dphi(ak4Jets[2], PuppiMET[0]) < 0.1)

region CRphotonlowdM
  take collisionDataQuality
  trigger HLTPhoton
  select size(selectedPhotons) == 1
  select size(vetoLeptons) == 0
  select size(selectedHadTaus) == 0
  select size(isotracks) == 0
  select size(ak4JetsCRpho) >= 2
  select size(ak4bJetsCRpho) >= 1
  select sum(pT(ak4JetsCRpho)) > 300
  select pT(PuppiMET[0]) < 250
  select photonRecoil > 250
  select NbstCRpho == 0
  select NmixCRpho == 0
  select NwCRpho == 0
  select NresCRpho == 0
  select dphi(ak4JetsCRpho[0], photonRecoilVector) > 0.5
  select dphi(ak4JetsCRpho[1], photonRecoilVector) > 0.15
  select size(ak4JetsCRpho) < 3 or dphi(ak4JetsCRpho[2], photonRecoilVector) > 0.15

region CRDYeelowdM
