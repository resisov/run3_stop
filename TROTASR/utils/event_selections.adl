  bin pT(PuppiMET[0]) >= 250 and pT(PuppiMET[0]) < 300
  bin pT(PuppiMET[0]) >= 300 and pT(PuppiMET[0]) < 350
  bin pT(PuppiMET[0]) >= 350 and pT(PuppiMET[0]) < 400
  bin pT(PuppiMET[0]) >= 400 and pT(PuppiMET[0]) < 500
  bin pT(PuppiMET[0]) >= 500 and pT(PuppiMET[0]) < 800
  bin pT(PuppiMET[0]) >= 800

region CRlostLepton
  take collisionDataQuality
  trigger HLTMETMHT
  select size(vetoLeptons) == 1
  select size(selectedHadTaus) == 0
  select size(isotracks) == 0
  select size(ak4Jets) >= 4
  select size(bJets) >= 1
  select Nbst + Nmix + Nres + Nw >= 1
  select HT > 300
  select pT(PuppiMET[0]) > 250
  select fMT(vetoLeptons[0], PuppiMET[0]) < 100
  select all(dphi(ak4Jets[0:4], PuppiMET[0]) > 0.5)

region CRmultijet
  take collisionDataQuality
  trigger HLTMETMHT
  select size(vetoLeptons) == 0
  select size(selectedHadTaus) == 0
  select size(isotracks) == 0
  select size(ak4Jets) >= 4
  select size(bJets) >= 1
  select Nbst + Nmix + Nres + Nw >= 1
  select HT > 300
  select pT(PuppiMET[0]) > 250
  select any(dphi(ak4Jets[0:4], PuppiMET[0]) < 0.5)
  select any(dphi(ak4Jets[0:3], PuppiMET[0]) < 0.1)

region CRphoton
  take collisionDataQuality
  trigger HLTPhoton
  select size(selectedPhotons) == 1
  select size(vetoElectrons) == 0 and size(vetoMuons) == 0
  select size(selectedHadTaus) == 0
  select size(isotracks) == 0
  select size(ak4JetsCRpho) >= 4
  select size(ak4bJetsCRpho) >= 1
  select NbstCRpho + NmixCRpho + NresCRpho + NwCRpho >= 1
  select HTCRpho > 300
  select pT(PuppiMET[0]) < 250
  select photonRecoil > 250
  select all(dphi(ak4JetsCRpho[0:4], photonRecoilVector) > 0.5)

region CRDYee
  take collisionDataQuality
  trigger HLTEle
  select size(selectedElectrons) == 2
  select size(vetoMuons) == 0
  select size(selectedHadTaus) == 0
  select size(isotracks) == 0
  select pT(selectedElectrons[0]) > 40
  select pT(selectedElectrons[1]) > 20
  select q(selectedElectrons[0]) + q(selectedElectrons[1]) == 0
  select m(eeVector) > 71 and m(eeVector) < 111
  select pT(eeVector) > 200
  select eeRecoil > 250
  select size(ak4JetsCRll) >= 4
  select size(ak4bJetsCRll) >= 1
  select NbstCRee + NmixCRee + NresCRee + NwCRee >= 1
  select sum(pT(ak4JetsCRll)) > 300
  select all(dphi(ak4JetsCRll[0:4], eeRecoilVector) > 0.5)

region CRDYmumu
  take collisionDataQuality
  trigger HLTMu
  select size(selectedMuons) == 2
  select size(vetoElectrons) == 0
  select size(selectedHadTaus) == 0
  select size(isotracks) == 0
  select pT(selectedMuons[0]) > 50
  select pT(selectedMuons[1]) > 20
  select q(selectedMuons[0]) + q(selectedMuons[1]) == 0
  select m(mumuVector) > 71 and m(mumuVector) < 111
  select pT(mumuVector) > 200
  select mumuRecoil > 250
  select size(ak4JetsCRll) >= 4
  select size(ak4bJetsCRll) >= 1
  select NbstCRmumu + NmixCRmumu + NresCRmumu + NwCRmumu >= 1
  select sum(pT(ak4JetsCRll)) > 300
  select all(dphi(ak4JetsCRll[0:4], mumuRecoilVector) > 0.5)

region SRpresellowdM
  take collisionDataQuality
  trigger HLTMETMHT
  select size(vetoLeptons) == 0
  select size(selectedHadTaus) == 0
  select size(isotracks) == 0
  select size(ak4Jets) >= 2
  select size(bJets) >= 1
  select HT > 300
  select pT(PuppiMET[0]) > 250
  select Nbst == 0
  select Nmix == 0
  select Nw == 0
  select Nres == 0
  select dphi(ak4Jets[0], PuppiMET[0]) > 0.5
  select dphi(ak4Jets[1], PuppiMET[0]) > 0.15
  select size(ak4Jets) < 3 or dphi(ak4Jets[2], PuppiMET[0]) > 0.15

region SR_lowdM_Nb1_NISR0
  take SRpresellowdM
  select size(bJets) == 1
  select size(ak8JetsISR) == 0
  bin gnn_score >= 0.0 and gnn_score < 0.5725103585725855
  bin gnn_score >= 0.5725103585725855 and gnn_score < 0.8620847087987249
  bin gnn_score >= 0.8620847087987249 and gnn_score < 0.9360990208521849
  bin gnn_score >= 0.9360990208521849 and gnn_score < 0.9851454291100825
  bin gnn_score >= 0.9851454291100825 and gnn_score <= 1.0

region SR_lowdM_Nb1_NISR1
  take SRpresellowdM
  select size(bJets) == 1
  select size(ak8JetsISR) == 1
  bin gnn_score >= 0.0 and gnn_score < 0.4337835196146913
  bin gnn_score >= 0.4337835196146913 and gnn_score < 0.7192719000531151
  bin gnn_score >= 0.7192719000531151 and gnn_score < 0.8272557967497884
  bin gnn_score >= 0.8272557967497884 and gnn_score < 0.9250179337760895
  bin gnn_score >= 0.9250179337760895 and gnn_score <= 1.0

region SR_lowdM_Nb1_NISR2plus
  take SRpresellowdM
  select size(bJets) == 1
  select size(ak8JetsISR) >= 2
  bin gnn_score >= 0.0 and gnn_score < 0.3255093377477263
  bin gnn_score >= 0.3255093377477263 and gnn_score < 0.7888373113816193
  bin gnn_score >= 0.7888373113816193 and gnn_score < 0.8877326655690037
  bin gnn_score >= 0.8877326655690037 and gnn_score < 0.9555760529187631
  bin gnn_score >= 0.9555760529187631 and gnn_score <= 1.0

region SR_lowdM_Nb2plus_NISR0
  take SRpresellowdM
  select size(bJets) >= 2
  select size(ak8JetsISR) == 0
  bin gnn_score >= 0.0 and gnn_score < 0.309950268336004
  bin gnn_score >= 0.309950268336004 and gnn_score < 0.7035191792183281
  bin gnn_score >= 0.7035191792183281 and gnn_score < 0.8914239639925238
  bin gnn_score >= 0.8914239639925238 and gnn_score < 0.9609786467235909
  bin gnn_score >= 0.9609786467235909 and gnn_score <= 1.0

region SR_lowdM_Nb2plus_NISR1
  take SRpresellowdM
  select size(bJets) >= 2
  select size(ak8JetsISR) == 1
  bin gnn_score >= 0.0 and gnn_score < 0.6463224331017129
