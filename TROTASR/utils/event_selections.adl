info analysis
  title "CMS Run-3 all-hadronic stop: signal and control regions"
  years 2024 2025
  objects "ids.adl"
  corrections "corrections.adl"
  energyunit GeV

info derivedInputs
  validMET "finite MET pT >= 0"
  certifiedLuminosity "golden JSON for data; true for MC"
  counts "SR/GCR/DY2E/DY2M_Nbst,Nmix,Nres,Nw = exclusive region counts from utils/event_selections.py:select"
  highdm_mtb "minimum mT(b,MET) of the two highest-UParT medium b jets; the single b jet if Nb=1"
  gnn_score "region-specific gnn4lowdm.inference.Rank005Numpy score"
  inputP4 "the calibrated event view; SR/LLCR/QCDCR use MET, GCR/DY use recoil"
  sourceBinning "jsons/highdm_sr_binning.json: 162 high-dM SR bins"
  finalBinning "jsons/sr_category_merge.json: 21 classes, 118 high-dM SR bins per year"
  lowBinning "gnn4lowdm/config.json: six classes, 30 low-dM SR bins per year"

triggerset HLTMETMHT
  trigger HLT_PFMET120_PFMHT120_IDTight or HLT_PFMET130_PFMHT130_IDTight or HLT_PFMET140_PFMHT140_IDTight or HLT_PFMETNoMu120_PFMHTNoMu120_IDTight or HLT_PFMETNoMu130_PFMHTNoMu130_IDTight or HLT_PFMETNoMu140_PFMHTNoMu140_IDTight

triggerset HLTPhoton
  trigger HLT_Photon175 or HLT_Photon200

triggerset HLTEle
  trigger HLT_Ele115_CaloIdVT_GsfTrkIdT or HLT_Ele135_CaloIdVT_GsfTrkIdT or HLT_Ele30_WPTight_Gsf or HLT_Ele32_WPTight_Gsf or HLT_Ele35_WPTight_Gsf or HLT_Ele38_WPTight_Gsf or HLT_Ele40_WPTight_Gsf or HLT_Ele23_Ele12_CaloIdL_TrackIdL_IsoVL_DZ or HLT_Ele23_Ele12_CaloIdL_TrackIdL_IsoVL or HLT_DoubleEle25_CaloIdL_MW or HLT_DoubleEle27_CaloIdL_MW or HLT_DoubleEle33_CaloIdL_MW

triggerset HLTMu
  trigger HLT_IsoMu20 or HLT_IsoMu24 or HLT_IsoMu27 or HLT_IsoMu24_eta2p1 or HLT_Mu50 or HLT_Mu55

define HT = sum(pT(ak4Jets))
define HTCRpho = sum(pT(ak4JetsCRpho))
define HTCRll = sum(pT(ak4JetsCRll))

define eeVector = selectedElectrons[0] + selectedElectrons[1]
define mumuVector = selectedMuons[0] + selectedMuons[1]
define photonRecoilVector = PuppiMET[0] + selectedPhotons[0]
define photonRecoil = pT(photonRecoilVector)
define eeRecoilVector = PuppiMET[0] + eeVector
define mumuRecoilVector = PuppiMET[0] + mumuVector
define eeRecoil = pT(eeRecoilVector)
define mumuRecoil = pT(mumuRecoilVector)

define Nbst = SR_Nbst
define Nmix = SR_Nmix
define Nres = SR_Nres
define Nw = SR_Nw
define NbstCRpho = GCR_Nbst
define NmixCRpho = GCR_Nmix
define NresCRpho = GCR_Nres
define NwCRpho = GCR_Nw
define NbstCRee = DY2E_Nbst
define NmixCRee = DY2E_Nmix
define NresCRee = DY2E_Nres
define NwCRee = DY2E_Nw
define NbstCRmumu = DY2M_Nbst
define NmixCRmumu = DY2M_Nmix
define NresCRmumu = DY2M_Nres
define NwCRmumu = DY2M_Nw
define mTb = highdm_mtb

region collisionDataQuality
  select validMET == 1
  select certifiedLuminosity == 1
  select size(vetoMapJets) == 0
  select Flag_goodVertices == 1
  select Flag_globalSuperTightHalo2016Filter == 1
  select Flag_HBHENoiseFilter == 1
  select Flag_HBHENoiseIsoFilter == 1
  select Flag_EcalDeadCellTriggerPrimitiveFilter == 1
  select Flag_BadPFMuonFilter == 1
  select Flag_BadPFMuonDzFilter == 1
  select Flag_eeBadScFilter == 1
  select Flag_ecalBadCalibFilter == 1
  select pT(PuppiMET[0]) / pT(CaloMET[0]) < 5

region SRpresel
  take collisionDataQuality
  trigger HLTMETMHT
  select size(vetoElectrons) + size(vetoMuons) == 0
  select size(selectedHadTaus) == 0
  select size(isotracks) == 0
  select size(ak4Jets) >= 4
  select size(bJets) >= 1
  select Nbst + Nmix + Nres + Nw >= 1
  select mTb >= 175
  select HT > 300
  select pT(PuppiMET[0]) > 250
  select all(dphi(ak4Jets[0:4], PuppiMET[0]) > 0.5)

region SR_class1
  take SRpresel
  select size(bJets) >= 1
  select Nbst == 0
  select Nmix == 0
  select Nres == 1
  select Nw == 0
  bin pT(PuppiMET[0]) >= 250 and pT(PuppiMET[0]) < 300
  bin pT(PuppiMET[0]) >= 300 and pT(PuppiMET[0]) < 350
  bin pT(PuppiMET[0]) >= 350 and pT(PuppiMET[0]) < 400
  bin pT(PuppiMET[0]) >= 400 and pT(PuppiMET[0]) < 500
  bin pT(PuppiMET[0]) >= 500 and pT(PuppiMET[0]) < 800
  bin pT(PuppiMET[0]) >= 800

region SR_class2
  take SRpresel
  select size(bJets) >= 1
  select Nbst == 0
  select Nmix == 0
  select Nres >= 1
  select Nw >= 1
  bin pT(PuppiMET[0]) >= 250 and pT(PuppiMET[0]) < 300
  bin pT(PuppiMET[0]) >= 300 and pT(PuppiMET[0]) < 350
  bin pT(PuppiMET[0]) >= 350 and pT(PuppiMET[0]) < 400
  bin pT(PuppiMET[0]) >= 400 and pT(PuppiMET[0]) < 500
  bin pT(PuppiMET[0]) >= 500

region SR_class3
  take SRpresel
  select size(bJets) >= 1
  select Nbst == 0
  select Nmix == 0
  select Nres >= 2
  select Nw == 0
  bin pT(PuppiMET[0]) >= 250 and pT(PuppiMET[0]) < 300
  bin pT(PuppiMET[0]) >= 300 and pT(PuppiMET[0]) < 350
  bin pT(PuppiMET[0]) >= 350 and pT(PuppiMET[0]) < 400
  bin pT(PuppiMET[0]) >= 400 and pT(PuppiMET[0]) < 500
  bin pT(PuppiMET[0]) >= 500

region SR_class4
  take SRpresel
  select size(bJets) >= 1
  select Nbst == 0
  select Nmix >= 1
  select Nres >= 1
  select Nw >= 0
  bin pT(PuppiMET[0]) >= 250 and pT(PuppiMET[0]) < 300
  bin pT(PuppiMET[0]) >= 300 and pT(PuppiMET[0]) < 350
  bin pT(PuppiMET[0]) >= 350 and pT(PuppiMET[0]) < 400
  bin pT(PuppiMET[0]) >= 400 and pT(PuppiMET[0]) < 500
  bin pT(PuppiMET[0]) >= 500 and pT(PuppiMET[0]) < 800
  bin pT(PuppiMET[0]) >= 800

